{
  "name": "skillshare-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "preview": "npm --workspace frontend run preview",
    "lint": "npm --workspace frontend run lint",
    "backend": "python backend/manage.py runserver 8000",
    "migrate": "python backend/manage.py migrate",
    "test:backend": "python backend/manage.py test core"
  }
}
